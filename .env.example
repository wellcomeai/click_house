# Database
DATABASE_URL=postgresql+asyncpg://clickhouse_user:clickhouse_pass@localhost:5432/clickhouse_db

# JWT
SECRET_KEY=your_secret_key_minimum_32_characters_long_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin user (created on first startup)
ADMIN_EMAIL=well96well@gmail.com
ADMIN_PASSWORD=change_this_in_production

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# kie.ai image generation
KIE_API_KEY=your_kie_api_key_here

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Frontend (for Vite)
VITE_API_URL=http://localhost:8000
